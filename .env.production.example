# ERP 시스템 운영 서버 배포 설정
# 복사: cp .env.production.example .env.production
# 주의: .env.production은 .gitignore에 포함되어 Git에 커밋되지 않습니다

# SSH 연결 정보
PROD_HOST=your-server.com           # 운영 서버 IP 또는 도메인
PROD_USER=ubuntu                     # SSH 사용자명
PROD_PORT=22                         # SSH 포트
SSH_KEY=$HOME/.ssh/id_rsa            # SSH 키 경로

# 배포 경로
PROD_DIR=/home/ubuntu/erp-system     # 원격 서버 배포 디렉토리

# 데이터베이스 (운영 서버)
PROD_DB_HOST=localhost
PROD_DB_PORT=5432
PROD_DB_NAME=erp_production
PROD_DB_USER=erp_prod_user
PROD_DB_PASSWORD=your_secure_password_here

# 백엔드 설정 (운영 서버)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# 프론트엔드 설정 (운영 서버)
VITE_API_BASE_URL=http://your-server.com:8080
