# ============================================
# Cursor ERP System - Blue-Green Nginx 설정
# ============================================
# 설치 위치: /etc/nginx/sites-enabled/erp.conf (Synology NAS)
#
# 사용법:
# 1. 이 파일을 Synology NAS로 복사
# 2. /etc/nginx/sites-enabled/erp.conf로 이동
# 3. sudo nginx -t (설정 검증)
# 4. sudo nginx -s reload (적용)

# ============================================
# Blue 환경 Upstream
# ============================================
upstream backend-blue {
    server localhost:8991;
    keepalive 32;
}

upstream frontend-blue {
    server localhost:8990;
    keepalive 32;
}

# ============================================
# Green 환경 Upstream
# ============================================
upstream backend-green {
    server localhost:8993;
    keepalive 32;
}

upstream frontend-green {
    server localhost:8992;
    keepalive 32;
}

# ============================================
# 활성 환경 전환 포인트 ⭐
# ============================================
# 이 부분만 수정하여 Blue/Green 전환
# Blue → Green: 8991 → 8993, 8990 → 8992
# Green → Blue: 8993 → 8991, 8992 → 8990

upstream active-backend {
    server localhost:8991;  # Blue: 8991, Green: 8993
    keepalive 32;
}

upstream active-frontend {
    server localhost:8990;  # Blue: 8990, Green: 8992
    keepalive 32;
}

# ============================================
# HTTP Server
# ============================================
server {
    listen 80;
    server_name erp.fehu.kr;

    # 로그 설정
    access_log /var/log/nginx/erp_access.log;
    error_log /var/log/nginx/erp_error.log;

    # 최대 업로드 크기
    client_max_body_size 10M;

    # ========================================
    # 프론트엔드
    # ========================================
    location / {
        proxy_pass http://active-frontend;
        proxy_http_version 1.1;

        # 프록시 헤더
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 캐시 우회
        proxy_cache_bypass $http_upgrade;

        # 타임아웃
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ========================================
    # 백엔드 API
    # ========================================
    location /api/ {
        proxy_pass http://active-backend/;
        proxy_http_version 1.1;

        # 프록시 헤더
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 캐시 우회
        proxy_cache_bypass $http_upgrade;

        # 타임아웃 (API 요청은 더 길게)
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # ========================================
    # Health Check 엔드포인트
    # ========================================
    location /health {
        proxy_pass http://active-backend/actuator/health;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # Health Check는 빠르게
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;

        # 로그 최소화 (자주 호출되므로)
        access_log off;
    }

    # ========================================
    # Actuator 엔드포인트 (모니터링용)
    # ========================================
    location /actuator/ {
        proxy_pass http://active-backend/actuator/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 내부 네트워크만 허용 (선택)
        # allow 192.168.0.0/16;
        # deny all;
    }

    # ========================================
    # 정적 파일 캐싱
    # ========================================
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://active-frontend;

        # 캐시 설정
        expires 1y;
        add_header Cache-Control "public, immutable";

        # gzip 압축
        gzip_static on;
    }
}

