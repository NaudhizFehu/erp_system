## 💻 코딩 컨벤션

### TypeScript/JavaScript

#### 네이밍
```typescript
// ✅ 올바른 예시
const userName = 'John'                    // camelCase for variables
const MAX_RETRY_COUNT = 3                  // UPPER_SNAKE_CASE for constants
interface UserProfile { }                  // PascalCase for interfaces
type AccountType = 'ASSET' | 'LIABILITY'   // PascalCase for types
enum DebitCreditType { }                   // PascalCase for enums
function getUserData() { }                 // camelCase for functions
const AccountForm = () => { }              // PascalCase for components

// ❌ 잘못된 예시
const user_name = 'John'                   // snake_case 금지
const account_form = () => { }             // 컴포넌트는 PascalCase
```

#### 파일명
```
// ✅ 올바른 예시
AccountList.tsx                            // PascalCase for components
useAccounts.ts                             // camelCase for hooks
accountService.ts                          // camelCase for services
accounting.ts                              // camelCase for types

// ❌ 잘못된 예시
account_list.tsx                           // snake_case 금지
AccountService.ts                          // service는 camelCase
```

#### Import 순서
```typescript
// 1. React 및 외부 라이브러리
import { useState } from 'react'
import { useNavigate } from 'react-router-dom'

// 2. UI 컴포넌트
import { Button } from '@/components/ui/button'
import { Card } from '@/components/ui/card'

// 3. 커스텀 훅 및 서비스
import { useAccounts } from '@/hooks/useAccounts'
import { accountService } from '@/services/accountService'

// 4. 타입
import { Account, AccountType } from '@/types/accounting'
```

### React Query 패턴

```typescript
// ✅ 올바른 패턴
// 1. Service Layer (services/accountService.ts)
export const accountService = {
  getAccounts: async (params?: AccountSearchParams) => {
    const response = await api.get<PaginatedResponse<Account>>('/api/accounts', { params })
    return response.data
  },
}

// 2. Custom Hook (hooks/useAccounts.ts)
export const useAccounts = (params?: AccountSearchParams) => {
  return useQuery({
    queryKey: ['accounts', params],
    queryFn: () => accountService.getAccounts(params),
  })
}

// 3. Component Usage
const { data, isLoading, error } = useAccounts(params)
```

### Form 패턴

```typescript
// ✅ React Hook Form + Zod 패턴
const accountFormSchema = z.object({
  accountCode: z.string().min(1, '계정코드는 필수입니다'),
  accountName: z.string().min(2, '계정명은 2자 이상이어야 합니다'),
})

type AccountFormData = z.infer<typeof accountFormSchema>

const form = useForm<AccountFormData>({
  resolver: zodResolver(accountFormSchema),
  defaultValues: { ... },
})
```

