│   │   ├── hr/           # 인사 모듈 컴포넌트
│   │   ├── inventory/    # 재고 모듈 컴포넌트
│   │   ├── sales/        # 영업 모듈 컴포넌트
│   │   └── accounting/   # 회계 모듈 컴포넌트
│   ├── pages/            # 페이지 컴포넌트
│   │   ├── auth/
│   │   ├── hr/
│   │   ├── inventory/
│   │   ├── sales/
│   │   ├── accounting/
│   │   └── company/
│   ├── hooks/            # Custom Hooks (React Query)
│   ├── services/         # API Service Layer
│   ├── types/            # TypeScript 타입 정의
│   ├── contexts/         # React Context
