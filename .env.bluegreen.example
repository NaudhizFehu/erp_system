# Blue-Green 배포 환경 변수 설정
# 사용법: 이 파일을 .env.bluegreen으로 복사하고 실제 값을 입력하세요
# cp .env.bluegreen.example .env.bluegreen

# ============================================
# Synology NAS 접속 정보
# ============================================

# Synology NAS 호스트명 또는 IP
SYNOLOGY_HOST=your-nas.example.com

# Synology NAS 사용자명
SYNOLOGY_USER=your-username

# SSH 포트 (기본: 22)
SYNOLOGY_PORT=22

# SSH 키 경로
SSH_KEY=$HOME/.ssh/id_rsa

# ============================================
# 배포 경로
# ============================================

# Synology NAS 배포 디렉토리
DEPLOY_DIR=/var/services/homes/your-username/erp-system

# nginx 설정 파일 경로 (Synology)
NGINX_CONF_PATH=/etc/nginx/sites-enabled/erp.conf

# ============================================
# Docker 설정
# ============================================

# Docker Compose 파일명
DOCKER_COMPOSE_FILE=docker-compose.prod.yml

# 버전 태그 (기본: 날짜 기반 자동 생성)
# VERSION=1.0.0
VERSION=latest

# ============================================
# Health Check 설정
# ============================================

# Health Check 타임아웃 (초)
HEALTH_CHECK_TIMEOUT=60

# Health Check 재시도 간격 (초)
HEALTH_CHECK_INTERVAL=5

# ============================================
# 데이터베이스 정보 (참고용)
# ============================================

# PostgreSQL 호스트
DB_HOST=your-db-host.example.com

# PostgreSQL 포트
DB_PORT=5432

# 데이터베이스명
DB_NAME=your_database_name

# 데이터베이스 사용자
DB_USER=your_db_user

# 데이터베이스 비밀번호 (실제 값은 docker-compose.prod.yml에 설정)
# DB_PASSWORD=your_secure_password
