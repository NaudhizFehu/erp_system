# Blue-Green 배포 환경 변수 설정
# 이 파일은 실제 서버 정보를 포함하고 있습니다. (.gitignore에 포함됨)

# ============================================
# Synology NAS 접속 정보
# ============================================

# Synology NAS 호스트명 또는 IP (로컬 네트워크)
SYNOLOGY_HOST=192.168.0.30

# Synology NAS 사용자명
SYNOLOGY_USER=naudhizfehu

# SSH 포트
SYNOLOGY_PORT=17215

# SSH 키 경로
SSH_KEY=$HOME/.ssh/id_rsa

# ============================================
# 배포 경로
# ============================================

# Synology NAS 배포 디렉토리
DEPLOY_DIR=/var/services/homes/naudhizfehu/erp-system

# nginx 설정 파일 경로 (Synology)
NGINX_CONF_PATH=/etc/nginx/sites-enabled/erp.conf

# ============================================
# Docker 설정
# ============================================

# Docker Compose 파일명
DOCKER_COMPOSE_FILE=docker-compose.prod.yml

# 버전 태그 (기본: 날짜 기반 자동 생성)
# VERSION=1.0.0
VERSION=latest

# ============================================
# Health Check 설정
# ============================================

# Health Check 타임아웃 (초)
HEALTH_CHECK_TIMEOUT=60

# Health Check 재시도 간격 (초)
HEALTH_CHECK_INTERVAL=5

# ============================================
# 데이터베이스 정보 (참고용)
# ============================================

# PostgreSQL 호스트
DB_HOST=fehu.kr

# PostgreSQL 포트
DB_PORT=5432

# 데이터베이스명
DB_NAME=cursor_erp_system

# 데이터베이스 사용자
DB_USER=cursor_erp_system

# 데이터베이스 비밀번호 (실제 값은 docker-compose.prod.yml에 설정)
# DB_PASSWORD=cursor_erp_system
